# Copy to .env and fill in. Never commit .env.

# Database (PostgreSQL 18). App user only; migrations use DATABASE_MIGRATE_URL.
DATABASE_URL="postgresql://privateconnet_app:CHANGE_ME@localhost:5432/privateconnet"
DATABASE_MIGRATE_URL="postgresql://privateconnet_migrate:CHANGE_ME@localhost:5432/privateconnet"

# Public origins
APP_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3000"

# 32-byte keys, base64. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_ENCRYPTION_KEY encrypts MemberPrivate columns (AES-256-GCM).
FIELD_ENCRYPTION_KEY=""
# BLIND_INDEX_KEY makes the searchable, unique phone hash (HMAC-SHA256). Must differ from the key above.
BLIND_INDEX_KEY=""
# MEDIA_SIGNING_KEY signs short-lived photo links.
MEDIA_SIGNING_KEY=""

# Better Auth (staff sign-in)
BETTER_AUTH_SECRET=""

# Private photo storage, outside the web root
MEDIA_ROOT="/var/lib/privateconnet/media"

# Support line shown in the app (ONB-15)
SUPPORT_PHONE="+231778104168"
